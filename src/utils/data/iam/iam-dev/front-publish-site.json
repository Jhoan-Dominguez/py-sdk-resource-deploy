{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheSiteBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::sf-onboarding-dev-app-${AWS_ACCOUNT_ID}"
    },
    {
      "Sid": "PublishFiles",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::sf-onboarding-dev-app-${AWS_ACCOUNT_ID}/*"
    },
    {
      "Sid": "RefreshCloudFront",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::${AWS_ACCOUNT_ID}:distribution/*"
    }
  ]
}
